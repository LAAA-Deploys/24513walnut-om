  <div class="preview-band">Confidential Offering Memorandum · Interactive Prototype · July 2026</div>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="24513 Walnut offering home">
      <span class="brand-slot" data-laaa-brand-slot="header" data-logo-variant="blue" data-brand-context="light"><img src="assets/brand/LAAA_Team_Blue.png" alt="LAAA Team"></span>
      <span class="site-descriptor">Offering Memorandum</span>
