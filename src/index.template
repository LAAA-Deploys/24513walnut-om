    <button class="menu-toggle" data-laaa-menu-toggle type="button" aria-expanded="false" aria-controls="primary-nav"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><span class="sr-only menu-label" data-laaa-menu-label>Open navigation</span></button>
